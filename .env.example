# ---------------------------------------------------------------------------
# KASE Bond AI — copy to .env and adjust.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
# development | staging | production | test
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- database --------------------------------------------------------------
POSTGRES_USER=kase
POSTGRES_PASSWORD=kase
POSTGRES_DB=kase_bond_ai
POSTGRES_PORT=5432
# Used by the backend directly (outside docker compose point it at localhost).
DATABASE_URL=postgresql+psycopg://kase:kase@localhost:5432/kase_bond_ai

# --- ports -----------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- KASE data source ------------------------------------------------------
# offline             never contact KASE at all; serve the last verified data
#                     from the database, labelled cached with its real age.
#                     Bootstrap with: python scripts/kase.py import-snapshot
# public_api          the public JSON API kase.kz serves to its own front end.
#                     Verified endpoint by endpoint, needs no key. THIS IS THE
#                     Fast structured mode; does not emulate a visitor.
# auto                contract API (if a key is set) -> public JSON API ->
#                     browser agent -> HTML reader -> cache -> demo (dev only)
# official_api        contracted KASE API only; requires KASE_API_KEY
# website_structured  plain HTTP reader of kase.kz HTML (alias: website)
# browser             real Chromium session on the public kase.kz site.
#                     Recommended when analysis must follow the same visible
#                     pages, tabs and controls as an ordinary visitor.
# mock                synthetic demo data; REFUSED when APP_ENV=production
#
# NOTE: only official_api needs KASE_API_KEY. Everything a normal visitor can
# see on kase.kz is reachable without one.
KASE_DATA_MODE=browser
KASE_API_KEY=
KASE_API_URL=https://api.kase.kz
KASE_WEBSITE_URL=https://kase.kz
KASE_HTTP_TIMEOUT=15
KASE_LANGUAGE=ru

# Set to true to let the test-suite hit the real KASE endpoints.
RUN_LIVE_KASE_TESTS=false

# --- browser agent ---------------------------------------------------------
# Reads the public site as an ordinary visitor: real Chromium, real JavaScript.
# It never bypasses a login, a paywall or a CAPTCHA.
#   python -m playwright install chromium   # once, to download the engine
BROWSER_ENABLED=true
BROWSER_ENGINE=chromium
BROWSER_HEADLESS=true
BROWSER_LOCALE=ru-RU
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_NAV_TIMEOUT_MS=45000
# Politeness / anti-hammering.
BROWSER_MAX_CONCURRENCY=2
BROWSER_MIN_INTERVAL_MS=1200
BROWSER_MAX_RETRIES=3
BROWSER_BACKOFF_BASE_MS=1500
# Hard stops: no extraction loop may run forever.
BROWSER_MAX_PAGES=20
BROWSER_MAX_SCROLLS=30
BROWSER_MAX_ROWS=5000
BROWSER_MAX_RUNTIME_S=180
# Page cache TTLs, seconds.
BROWSER_CACHE_TTL_CATALOG_S=3600
BROWSER_CACHE_TTL_BOND_S=900
BROWSER_CACHE_TTL_ISSUER_S=21600
# Artefacts (screenshots, downloads).
BROWSER_ARTIFACT_DIR=./var/browser
BROWSER_STORE_SCREENSHOTS=true
BROWSER_MAX_STORED_SCREENSHOTS=200
# Visual analysis of charts/images. Qualitative only, never a price source.
BROWSER_VISUAL_ANALYSIS_ENABLED=true
BROWSER_VISION_MODEL=

# Set to true to run the live browser integration test against kase.kz.
RUN_LIVE_BROWSER_TESTS=false

# --- incremental KASE ingestion -------------------------------------------
# Fast HTTP/metadata checks gate expensive browser extraction. PostgreSQL is
# the source of truth; cache and hashes only avoid duplicate work.
INCREMENTAL_ENABLED=true
INCREMENTAL_PARSER_VERSION=2.0.0
INCREMENTAL_FAST_CHECK_TIMEOUT=12
INCREMENTAL_FORCE_FULL_AFTER_HOURS=168
INCREMENTAL_MISSING_FIELD_RATIO=0.60
MATERIAL_YTM_ABSOLUTE_CHANGE=0.005
MATERIAL_PRICE_PERCENT_CHANGE=1.0
MATERIAL_SPREAD_CHANGE=0.5
MATERIAL_CREDIT_SCORE_CHANGE=5.0
MATERIAL_LIQUIDITY_SCORE_CHANGE=5.0
MATERIAL_TRADE_VOLUME_CHANGE=0.25
SCHEDULE_QUOTES_SECONDS=900
SCHEDULE_CATALOG_SECONDS=21600
SCHEDULE_DOCUMENTS_SECONDS=21600
SCHEDULE_NEWS_SECONDS=3600
SCHEDULE_AI_TASKS_SECONDS=60
SCHEDULE_BOND_TERMS_SECONDS=86400
RAW_SNAPSHOT_RETENTION_DAYS=30

# Loads the synthetic demo dataset when the backend container starts.
# Has no effect when APP_ENV=production.
SEED_DEMO_DATA=true

# --- AI --------------------------------------------------------------------
# KASE Bond AI runs its own model. The backend talks to our inference service,
# not to a third-party API. See docs/ai/architecture.md.
#
#   local     наша модель (по умолчанию)
#   external  внешний OpenAI-совместимый эндпоинт — только для сравнения
#   off       без модели: везде показываются детерминированные объяснения
AI_PROVIDER=local
AI_ENABLED=true
AI_TIMEOUT=30
AI_MAX_TOKENS=900

# Наш сервис инференса: uvicorn ai.inference.server:app --port 8100
KASE_AI_URL=http://127.0.0.1:8100
KASE_AI_MODEL_VERSION=kase-ai-v0.1

# Какой рантайм поднимает сервис инференса (ai/configs/inference.yaml).
#   rules        детерминированный движок без весов — работает всегда
#   vllm         наши веса на нашей GPU: vllm serve models/<run>/merged
#   llama_cpp    наши веса в GGUF на CPU
#   transformers наши веса в одном процессе
KASE_AI_RUNTIME=rules

# live: AI tools refresh public market facts directly from official kase.kz.
# snapshot: fully offline/reproducible mode. Live access is read-only, host-
# restricted and uses no paid API or API key.
KASE_AI_DATA_MODE=live
KASE_AI_LIVE_TTL_SECONDS=300

# Используются ТОЛЬКО при AI_PROVIDER=external (режим сравнения, §36).
OPENAI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

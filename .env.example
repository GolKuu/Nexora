# ---------------------------------------------------------------------------
# KASE Bond AI — copy to .env and adjust.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
# development | staging | production | test
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- database --------------------------------------------------------------
POSTGRES_USER=kase
POSTGRES_PASSWORD=kase
POSTGRES_DB=kase_bond_ai
POSTGRES_PORT=5432
# Used by the backend directly (outside docker compose point it at localhost).
DATABASE_URL=postgresql+psycopg://kase:kase@localhost:5432/kase_bond_ai

# --- ports -----------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- KASE data source ------------------------------------------------------
# auto          official API (if a key is set) -> public website -> demo (dev only)
# official_api  contracted KASE API only; requires KASE_API_KEY
# website       public kase.kz pages only
# mock          synthetic demo data; REFUSED when APP_ENV=production
KASE_DATA_MODE=mock
KASE_API_KEY=
KASE_API_URL=https://api.kase.kz
KASE_WEBSITE_URL=https://kase.kz
KASE_HTTP_TIMEOUT=15

# Set to true to let the test-suite hit the real KASE endpoints.
RUN_LIVE_KASE_TESTS=false

# Loads the synthetic demo dataset when the backend container starts.
# Has no effect when APP_ENV=production.
SEED_DEMO_DATA=true

# --- AI --------------------------------------------------------------------
# Any OpenAI-compatible endpoint: OpenAI, a Claude-compatible gateway, Qwen,
# Groq, Ollama, vLLM… Switching provider means changing these three values.
AI_ENABLED=true
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
AI_MAX_TOKENS=900

# Examples:
#   Claude-compatible gateway: AI_BASE_URL=https://<gateway>/v1   AI_MODEL=claude-sonnet-4-5
#   Qwen (DashScope compat):   AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Local Ollama:              AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=qwen2.5

# --- frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

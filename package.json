{
  "name": "kase-bond-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Repo-root orchestration. `npm run setup` prepares everything; `npm run dev` starts the Next.js frontend and the FastAPI backend (which owns the scheduler) together.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "node scripts/py.mjs -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "test": "node scripts/py.mjs -m pytest",
    "backfill": "node scripts/py.mjs -m app.jobs.backfill_kase_stocks",
    "migrate": "node scripts/py.mjs -m alembic upgrade head",
    "install:frontend": "npm install --prefix frontend"
  },
  "engines": {
    "node": ">=20"
  }
}

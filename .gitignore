# python
__pycache__/
*.py[cod]
.venv/
.venv-train/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# databases
*.db
*.sqlite3
tests/.test.db
# WAL sidecars. SQLite runs in WAL mode (see app/db/session.py), so these
# appear next to every SQLite file and must never be committed.
*.db-wal
*.db-shm

# node / next
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-error.log*

# env & secrets
.env
.env.local
.env.*.local
!.env.example

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# browser agent artefacts (screenshots, downloads)
var/

# build artifacts
dist/
build/
coverage/

# --- AI ---------------------------------------------------------------------
# Model weights and checkpoints: too large for git, and reproducible from the
# dataset version + config recorded in metadata.json. The metadata and the
# model card ARE committed - they are how a checkpoint is identified.
models/*/adapter/
models/*/merged/
models/*/checkpoints/
models/*/gguf/
models/*/awq-*/
!models/*/metadata.json
!models/*/model_card.md
# Smoke runs are disposable pipeline checks, not releasable model records.
models/*-smoke/

# Temporary complete archives produced before they are split into GitHub-safe
# multipart artifacts. The numbered parts and manifests live in artifacts/.
artifacts/multipart/*.archive.zip
artifacts/multipart/*.restored.zip

# Retrieval vectors: rebuildable from the committed chunks in one command
# (python -m ai.retrieval.index --version <v>).
data/ai/index/*/vectors.npy
data/ai/index/*/records.jsonl

# Feedback queue holds user questions; it is operational data, not source.
var/ai-logs/
var/ai-review-queue.jsonl
